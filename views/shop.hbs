
<main class="shop-page">
  <div class="shop-intro">
    <h1 class="section-heading">Shop Our Cactuses</h1>
    <p>Find your perfect cactus</p>
  </div>

  <div class="shop-tools">
    <nav class="shop-categories" aria-label="Filter cactus products">
      <a class="category-pill {{#unless selectedCategory}}active{{/unless}}" href="/shop">All</a>
      {{#each categories}}
        <a class="category-pill {{#if selected}}active{{/if}}" href="{{url}}">{{name}}</a>
      {{/each}}
    </nav>
    <form id="shop-search" class="shop-search" action="/shop" method="get" role="search">
      {{#if selectedCategory}}<input type="hidden" name="category" value="{{selectedCategory}}">{{/if}}
      <label class="visually-hidden" for="product-search">Search cactuses</label>
      <input id="product-search" type="search" name="q" placeholder="Search cactuses..." value="{{query}}">
      <button type="submit">Search</button>
    </form>
  </div>

  {{#if products.length}}
    <div class="product-grid" id="product-grid">
      {{#each products}}
      <article class="product-card">
        <a class="product-image" href="/product/{{id}}" aria-label="View {{name}}">
          <img src="{{image}}" alt="{{alt}}" width="300" height="230" loading="lazy">
        </a>
        <div class="product-info">
          <h2><a href="/product/{{id}}">{{name}}</a></h2>
          <p class="category-label">{{category}}</p>
          <p class="price">{{euro price}}</p>
          <button type="button" class="add-to-cart" data-add-to-cart="{{id}}">Add to Cart</button>
          <p class="cart-message" data-cart-message aria-live="polite"></p>
        </div>
      </article>
      {{/each}}
    </div>
  {{else}}
    <div class="no-results"><p>No cactuses match your search. <a href="/shop"><strong>View all plants</strong></a>.</p></div>
  {{/if}}
</main>
