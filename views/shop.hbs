
<main class="shop-page">

  <section class="shop-heading">
    <h1>Shop Our Cactuses</h1>
    <p>Find your perfect cactus</p>
  </section>

  <!-- Category filters -->
  <nav class="shop-filters" aria-label="Cactus categories">
    <a href="/shop">All</a>
    <a href="/shop?category=Tall">Tall</a>
    <a href="/shop?category=Round">Round</a>
    <a href="/shop?category=Sharp">Sharp</a>
    <a href="/shop?category=Columnar">Columnar</a>
  </nav>

  <!-- Product grid -->
  <section class="product-grid">

    {{#each products}}

    <article class="product-card">

      <a href="/product/{{id}}">
        <div class="product-image">
          <img src="{{image}}" alt="{{alt}}">
        </div>
      </a>

      <div class="product-info">

        <h2>
          <a href="/product/{{id}}">
            {{name}}
          </a>
        </h2>

        <p class="category">{{category}}</p>

        <p class="price">{{euro price}}</p>

        <button
          type="button"
          class="add-to-cart"
          data-add-to-cart="{{id}}"
        >
          Add to Cart
        </button>

        <p data-cart-message aria-live="polite"></p>

      </div>

    </article>

    {{/each}}

  </section>

</main>
