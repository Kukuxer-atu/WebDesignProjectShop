{{!-- One wooden shelf for four categories on desktop; two shelves on mobile. --}}
<section class="categories-section my-4 my-md-5" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="visually-hidden">Shop by cactus category</h2>

    <div class="category-shelf">
        <div class="category-shelf-row">
            <a href="/shop?category=Tall" class="shelf-category">
                <span class="shelf-category-label">Tall</span>
                <img src="/images/pots/pot1.webp" alt="" class="shelf-cactus" loading="lazy">
            </a>

            <a href="/shop?category=Round" class="shelf-category">
                <span class="shelf-category-label">Round</span>
                <img src="/images/pots/pot3.webp" alt="" class="shelf-cactus" loading="lazy">
            </a>
        </div>

        <div class="category-shelf-row">
            <a href="/shop?category=Sharp" class="shelf-category">
                <span class="shelf-category-label">Sharp</span>
                <img src="/images/pots/pot2.webp" alt="" class="shelf-cactus" loading="lazy">
            </a>

            <a href="/shop?category=Columnar" class="shelf-category">
                <span class="shelf-category-label">Columnar</span>
                <img src="/images/pots/pot4.webp" alt="" class="shelf-cactus" loading="lazy">
            </a>
        </div>
    </div>
</section>
