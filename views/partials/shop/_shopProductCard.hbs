
<article class="shop-card h-100 d-flex flex-column">

    <!-- Product content -->
    <a href="/product/{{id}}"
       class="shop-card-link">

        <div class="shop-card-content">

            <!-- Cactus image -->
            <div class="shop-card-image">

                <img src="{{image}}"
                     alt="{{alt}}"
                     loading="lazy">

            </div>

            <!-- Details -->
            <div class="shop-card-details">

                <h2 class="shop-card-name">
                    {{name}}
                </h2>

                <p class="shop-card-price">
                    {{euro price}}
                </p>

            </div>

        </div>

    </a>


    <!-- Animated cart controls -->
    <div class="shop-card-bottom mt-auto"
         data-shop-cart
         data-product-id="{{id}}"
         data-product-name="{{name}}">

        <div class="shop-cart-action">

            <!-- Initial Add to Cart button -->
            <button type="button"
                    class="shop-quick-add"
                    data-shop-add
                    aria-label="Add {{name}} to cart">

                <span class="shop-add-label">
                    <i class="bi bi-bag-plus"
                       aria-hidden="true"></i>
                    Add to Cart
                </span>

                <span class="shop-added-label"
                      aria-hidden="true">
                    <i class="bi bi-check2"
                       aria-hidden="true"></i>
                    Added
                </span>

            </button>


            <!-- Quantity selector -->
            <div class="shop-qty-panel"
                 data-shop-qty-panel
                 aria-hidden="true"
                 inert>

                <div class="shop-qty-inner">

                    <!-- Decrease -->
                    <button type="button"
                            class="shop-qty-btn"
                            data-shop-minus
                            aria-label="Decrease quantity of {{name}}">

                        <i class="bi bi-dash"
                           aria-hidden="true"></i>

                    </button>

                    <!-- Editable quantity -->
                    <input type="number"
                           class="shop-qty-input"
                           data-shop-qty
                           value="0"
                           min="0"
                           max="99"
                           step="1"
                           inputmode="numeric"
                           aria-label="Quantity of {{name}} in cart">

                    <!-- Increase -->
                    <button type="button"
                            class="shop-qty-btn"
                            data-shop-plus
                            aria-label="Increase quantity of {{name}}">

                        <i class="bi bi-plus"
                           aria-hidden="true"></i>

                    </button>

                </div>

            </div>

        </div>

        <!-- Accessible cart announcement -->
        <span class="visually-hidden"
              data-shop-status
              aria-live="polite"></span>

    </div>

</article>
