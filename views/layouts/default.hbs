
<!DOCTYPE html>
<html lang="en">

<head>
    {{> share/_head}}
</head>

<body>

    {{!-- Hide standard navigation on product pages --}}
    
        {{> share/_nav}}


    {{{body}}}

    {{!-- Hide standard footer on product pages --}}
    {{#unless state.product}}
        {{> share/_footer}}
    {{/unless}}

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Shopping cart -->
    <script src="/js/cart.js"></script>



<!-- Shop quantity animation -->
{{#if state.shop}}
    <script src="/js/shop-quantity.js"></script>
{{/if}}


</body>
</html>
