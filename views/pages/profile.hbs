
<main class="container py-5">
  <section class="profile-page mx-auto text-center">

    <h1 class="mb-4">My Profile</h1>

    <div class="profile-card">

      {{#if user.photo}}
        <img
          src="{{user.photo}}"
          alt="Google profile picture"
          class="profile-page-avatar"
          referrerpolicy="no-referrer"
        >
      {{else}}
        <i class="bi bi-person-circle profile-page-fallback"></i>
      {{/if}}

      <h2 class="mt-3">{{user.name}}</h2>

      <p class="text-muted">{{user.email}}</p>

      <hr>

      <p class="text-success">
        <i class="bi bi-check-circle-fill"></i>
        Signed in with Google
      </p>

      <a href="/shop" class="btn btn-outline-success mt-2">
        Continue shopping
      </a>

      <form action="/auth/logout" method="POST" class="mt-3">
        <button type="submit" class="btn btn-success w-100">
          Sign out
        </button>
      </form>

    </div>

  </section>
</main>
