
<main class="shop-page container-fluid px-3 px-md-4 px-xl-5">

    {{!-- Shop heading and logo --}}
    {{> shop/_shopHero}}

    {{!-- Category filters --}}
    {{> shop/_shopFilters}}

    {{!-- Product grid --}}
    <section class="shop-products py-4">

        {{#if products.length}}

            <div class="row row-cols-2 row-cols-sm-3
                        row-cols-lg-4 g-3 g-xl-4">

                {{#each products}}

                    <div class="col">
                        {{> shop/_shopProductCard}}
                    </div>

                {{/each}}

            </div>

        {{else}}

            <div class="text-center py-5">

                <h2>No cactuses found</h2>

                <a href="/shop"
                   class="btn btn-success rounded-pill">
                    View All Cactuses
                </a>

            </div>

        {{/if}}

    </section>

</main>
